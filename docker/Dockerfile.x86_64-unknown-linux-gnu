FROM ghcr.io/cross-rs/x86_64-unknown-linux-gnu:0.2.5

# GPUI links `xkbcommon` and `xkbcommon-x11` when the x11 feature is enabled
# (see `#[link(name = ...)]` in the `xkbcommon` crate). The cross-rs 0.2.5
# base image ships neither library, so the linker fails without them.
# `libxkbcommon-dev` pulls in the `libxcb-xkb-dev` headers that
# `xkbcommon-x11.pc` requires.
#
# Both packages are available from the image's own Xenial repositories, so no
# extra apt source is needed. An earlier revision appended Focal entries to
# `/etc/apt/sources.list` solely to obtain `libxcb-xinput-dev`; that package is
# not a build requirement, because `x11rb`'s `xinput` feature only enables
# protocol definitions.
#
# Xenial's `libxcb1` is 1.11.1, which predates `xcb_send_request_with_fds64`.
# `x11rb`'s `xcb_ffi` backend references that symbol, so the final link of the
# `gauss` binary fails with an undefined reference even after every crate
# compiles. `libxcb1-dev` pins `libxcb1 (= 1.11.1-1ubuntu1)` exactly, so the
# runtime and its headers must be replaced together. Bionic's 1.13 pair
# declares only `libc6 (>= 2.17)`, so it installs on the image's glibc 2.23;
# fetching the two `.deb` files keeps the change to these packages, leaving the
# rest of the base image's sysroot untouched. `curl` and the CA certificates
# are already present in the base image, so this adds no download tool.
#
# These are fetched over HTTPS and pinned by SHA-256 rather than by apt alone:
# an unauthenticated HTTP fetch would let a network attacker substitute the
# package that ends up in the release binary. The digests are the ones the
# signed `bionic-updates` index publishes for this version, so the check ties
# each download to Ubuntu's own metadata rather than only to this file.
RUN apt-get update && \
    apt-get install --assume-yes --no-install-recommends \
        libxkbcommon-dev \
        libxkbcommon-x11-dev && \
    xcb_base="https://archive.ubuntu.com/ubuntu/pool/main/libx/libxcb" && \
    curl --fail --silent --show-error --output /tmp/libxcb1.deb \
        "$xcb_base/libxcb1_1.13-2~ubuntu18.04_amd64.deb" && \
    curl --fail --silent --show-error --output /tmp/libxcb1-dev.deb \
        "$xcb_base/libxcb1-dev_1.13-2~ubuntu18.04_amd64.deb" && \
    printf '%s  %s\n' \
        "9a29e9ff0598a2bde15de5f53152247607515183548b342eea7f397a5df4cf38" \
        "/tmp/libxcb1.deb" \
        "3b308d513bdedf949b67b8a1679ff6093085c7cea34b339292902651108ab270" \
        "/tmp/libxcb1-dev.deb" \
        | sha256sum --check --strict && \
    dpkg --install /tmp/libxcb1.deb /tmp/libxcb1-dev.deb && \
    rm -f /tmp/libxcb1.deb /tmp/libxcb1-dev.deb && \
    rm -rf /var/lib/apt/lists/*

# `.cargo/config.toml` pins `linker = "clang"` for this very triple, and the
# cross-rs 0.2.5 image ships no clang. Cross exports a linker only for the
# target it was asked to build, so build scripts — which compile for the
# container's host, this same triple — resolve `clang` and fail with "linker
# `clang` not found". Pointing the host triple at `gcc`, which the image does
# have, keeps that link working without adding a toolchain the image lacks.
#
# Host builds outside cross are unaffected: the override lives in the build
# image, not in `.cargo/config.toml`, so local development keeps the `clang`
# the configuration selects.
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=gcc
