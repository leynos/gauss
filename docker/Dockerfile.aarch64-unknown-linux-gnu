FROM ghcr.io/cross-rs/aarch64-unknown-linux-gnu:0.2.5

# GPUI links `xkbcommon` and `xkbcommon-x11` when the x11 feature is enabled
# (see `#[link(name = ...)]` in the `xkbcommon` crate). The cross-rs 0.2.5
# base image ships neither library in its arm64 sysroot, so the linker fails
# without them. `libxkbcommon-dev` pulls in the `libxcb-xkb-dev` headers that
# `xkbcommon-x11.pc` requires.
#
# Everything needed is present in the Xenial ports repository that the base
# image already configures for arm64. Registering arm64 as a foreign
# architecture is still required, because the image's native architecture is
# amd64 and apt will not resolve an `:arm64` suffix otherwise.
#
# Earlier revisions of this file additionally rewrote `/etc/apt/sources.list`
# to add Focal entries. That duplicated the `[arch=...]` options already
# present on those lines, which apt rejects as "Malformed entry", and Focal's
# libc6 could not coexist with the image's glibc 2.23 sysroot anyway.
RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install --assume-yes --no-install-recommends \
        libxkbcommon-dev:arm64 \
        libxkbcommon-x11-dev:arm64 && \
    rm -rf /var/lib/apt/lists/*
