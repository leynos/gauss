FROM ghcr.io/cross-rs/aarch64-unknown-linux-gnu:0.2.5

# The cross-rs 0.2.5 base image uses Ubuntu 16.04 which does not include
# libxcb-xinput-dev. We add Ubuntu 20.04 (focal) repositories to install
# the missing packages required by x11rb with the xinput feature.

RUN echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports focal main universe" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports focal-updates main universe" >> /etc/apt/sources.list && \
    dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install --assume-yes --no-install-recommends \
        libxcb1-dev:arm64 \
        libxcb-randr0-dev:arm64 \
        libxcb-render0-dev:arm64 \
        libxcb-shape0-dev:arm64 \
        libxcb-sync-dev:arm64 \
        libxcb-xfixes0-dev:arm64 \
        libxcb-xinput-dev:arm64 \
        libxcb-xkb-dev:arm64 \
        libxcb-cursor-dev:arm64 \
        libxcb-shm0-dev:arm64 \
        libxkbcommon-dev:arm64 \
        libxkbcommon-x11-dev:arm64 && \
    rm -rf /var/lib/apt/lists/*
